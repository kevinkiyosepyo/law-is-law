# Optional password for signing back into this local app. Otherwise use its one-time terminal link.
APP_PASSWORD=
PORT=4310

# Read-only Clio integration. Register this exact callback in your Clio developer app.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:4310/api/clio/callback
CLIO_REGION=US
# Optional existing access token; use OAuth above for refresh-token support.
CLIO_ACCESS_TOKEN=

# Optional path to an original text export; omitted uses the supplied local Sapini export when present.
SAMPLE_CASE_PATH=
